{
  "realm": "product-service",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "clients": [
    {
      "clientId": "account-api",
      "enabled": true,
      "protocol": "openid-connect",
      "bearerOnly": true
    },
    {
      "clientId": "backend-login",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "demo-login-secret",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "defaultClientScopes": [
        "basic",
        "profile",
        "email",
        "roles"
      ],
      "protocolMappers": [
        {
          "name": "account-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "account-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "backend-registration",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "demo-registration-secret",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "fullScopeAllowed": false,
      "defaultClientScopes": [
        "basic",
        "roles"
      ]
    }
  ],
  "clientScopeMappings": {
    "realm-management": [
      {
        "client": "backend-registration",
        "roles": [
          "manage-users"
        ]
      }
    ]
  },
  "users": [
    {
      "username": "service-account-backend-registration",
      "enabled": true,
      "serviceAccountClientId": "backend-registration",
      "clientRoles": {
        "realm-management": [
          "manage-users"
        ]
      }
    }
  ]
}
