# Локальное окружение. Скопируй в .env.docker и измени пароли перед общим доступом.
COMPOSE_PROJECT_NAME=account-service
API_PORT=18000
APP_DB_PORT=15432
KEYCLOAK_PORT=18081
RABBITMQ_PORT=5673
RABBITMQ_MANAGEMENT_PORT=15673
MINIO_PORT=19000
MINIO_CONSOLE_PORT=19001

# Пароли БД и RabbitMQ здесь используются в URL: выбирай URL-safe символы.
APP_DB_NAME=account_service
APP_DB_USER=account_app
APP_DB_PASSWORD=demo-app-db-password
KEYCLOAK_DB_PASSWORD=demo-keycloak-db-password
KEYCLOAK_ADMIN=demo-admin
KEYCLOAK_ADMIN_PASSWORD=demo-admin-password
KEYCLOAK_PUBLIC_URL=http://localhost:18081
KEYCLOAK_CLIENT_SECRET=demo-login-client-secret
KEYCLOAK_REGISTRATION_CLIENT_SECRET=demo-registration-client-secret
RABBITMQ_USER=account_service
RABBITMQ_PASSWORD=demo-rabbitmq-password
RABBITMQ_VHOST=account_service
RABBITMQ_HOSTNAME=account-service-rabbitmq
MINIO_ACCESS_KEY=demo-minio
MINIO_SECRET_KEY=demo-minio-password
MINIO_BUCKET=company-documents
CHECKO_API_KEY=
