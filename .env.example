KEYCLOAK_URL=http://localhost:8080
# При отдельном внутреннем адресе Keycloak укажи публичный URL, задающий issuer JWT.
KEYCLOAK_PUBLIC_URL=
KEYCLOAK_REALM=product-service
KEYCLOAK_CLIENT_ID=backend-login
KEYCLOAK_CLIENT_SECRET=replace-with-login-client-secret
KEYCLOAK_REGISTRATION_CLIENT_ID=backend-registration
KEYCLOAK_REGISTRATION_CLIENT_SECRET=replace-with-registration-client-secret
JWT_AUDIENCE=account-api
DB_URL=postgresql+asyncpg://account_app:replace-with-db-password@localhost:15432/account_service
CHECKO_API_KEY=
CHECKO_BASE_URL=https://api.checko.ru/v2/
CHECKO_TIMEOUT_SECONDS=20
MINIO_ENDPOINT=localhost:19000
MINIO_ACCESS_KEY=replace-with-minio-access-key
MINIO_SECRET_KEY=replace-with-minio-secret-key
MINIO_SECURE=false
MINIO_REGION=us-east-1
MINIO_BUCKET=company-documents
MINIO_TIMEOUT_SECONDS=10
DOCUMENT_MAX_BYTES=20971520
DOCUMENT_CLEANUP_INTERVAL_SECONDS=300
DOCUMENT_CLEANUP_GRACE_SECONDS=3600
RABBITMQ_URL=amqp://account_service:replace-with-rabbitmq-password@localhost:5673/account_service
RABBITMQ_HEARTBEAT=60
RABBITMQ_RECONNECT_INTERVAL=5
RABBITMQ_CONNECT_TIMEOUT=10
RABBITMQ_FAIL_FAST=true
RABBITMQ_PUBLISH_TIMEOUT_SECONDS=5
OUTBOX_POLL_INTERVAL_SECONDS=1
OUTBOX_BATCH_SIZE=25
OUTBOX_RETRY_SECONDS=2
OUTBOX_MAX_RETRY_SECONDS=60
